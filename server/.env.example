# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origin (Frontend URL - e.g. https://your-site.netlify.app)
CLIENT_URL=http://localhost:5173

# Public Backend URL (e.g. on Render)
SERVER_PUBLIC_URL=https://your-backend.onrender.com

# Reverse Proxy Hops (Use 2 for Netlify + Render architecture, 0 for local dev)
TRUST_PROXY_HOPS=2

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/occult_master
DB_SSL=false

# Authentication Secrets (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# Initial Admin User Credentials (Used by npm run seed:admin)
ADMIN_EMAIL=admin@astrovedainstitute.com
ADMIN_PASSWORD=your-secure-admin-password-here

# Supabase Storage Configuration (Private Course Materials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_MATERIALS_BUCKET=course-materials
