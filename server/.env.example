# ==============================================================================
# Server Environment Variables Configuration
# Copy this file to .env and populate with your production values:
# cp .env.example .env
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=5000
NODE_ENV=production

# Client & Public URLs
CLIENT_URL=https://yugoccult.in
SERVER_PUBLIC_URL=https://yugoccult.in

# Reverse Proxy Hops (Use 1 for single VPS Nginx reverse proxy, 0 for local dev without Nginx)
TRUST_PROXY_HOPS=1

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://yug_user:your_secure_db_password@127.0.0.1:5432/yug_occult_db
DB_SSL=false

# Authentication Secret (Must be a cryptographically strong random string, minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_minimum_32_characters_long

# Administrative Notification Email (Receives enquiries, lead alerts, order notifications)
ADMIN_NOTIFY_EMAIL=yanushka655@gmail.com

# Initial Admin Credentials (Used by seed script: npm run seed:admin)
ADMIN_EMAIL=admin@yugoccult.in
ADMIN_PASSWORD=replace_with_a_strong_temporary_admin_password

# ==============================================================================
# SMTP Mail Delivery Configuration (Nodemailer)
# ==============================================================================
# Examples:
# For Hostinger / cPanel: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_SECURE=true
# For Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# For Amazon SES: SMTP_HOST=email-smtp.ap-south-1.amazonaws.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@yugoccult.in
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="YugOccult Learning Academy" <support@yugoccult.in>

# ==============================================================================
# Storage Configuration (Private Course Materials & PDFs)
# ==============================================================================
# Leave empty to use local filesystem storage under server/uploads/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MATERIALS_BUCKET=course-materials

# ==============================================================================
# Cashfree Payment Gateway Configuration
# ==============================================================================
CASHFREE_CLIENT_ID=your_cashfree_client_id_here
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret_here
CASHFREE_ENV=production
CASHFREE_API_VERSION=2025-01-01
